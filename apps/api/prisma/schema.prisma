// Modelo de dados do Paglamp Diagram — SPEC-001 §2.1.
// Formato do conteúdo do documento (yState): ADR-002 / SPEC-001 §2.2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MEMBER
}

enum DocumentType {
  MINDMAP
  DIAGRAM
}

/// Tipo de versão guardada (SPEC-005 §2.1).
enum SnapshotKind {
  /// Periódica, ou ao sair o último editor.
  AUTO
  /// Criada por uma pessoa, com nome.
  NAMED
  /// Guardada antes de restaurar ou de uma operação grande.
  CHECKPOINT
}

/// Pasta pessoal (só do dono) ou compartilhada com a equipe (SPEC-004 §2.1).
enum FolderKind {
  PERSONAL
  SHARED
}

enum MemberRole {
  OWNER
  EDITOR
  COMMENTER
  VIEWER
}

model User {
  id                 String           @id @default(cuid())
  /// Sempre minúsculo e sem espaços.
  email              String           @unique
  name               String
  role               UserRole         @default(MEMBER)
  passwordHash       String
  mustChangePassword Boolean          @default(true)
  /// Usuário nunca é apagado, só desativado.
  active             Boolean          @default(true)
  failedLoginCount   Int              @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  sessions           Session[]
  memberships        DocumentMember[]
  ownedDocuments     Document[]       @relation("owner")
  ownedFolders       Folder[]         @relation("folderOwner")
  folderMemberships  FolderMember[]
  placements         DocumentPlacement[]
}

model Session {
  id         String   @id @default(cuid())
  /// SHA-256 do token. O token em si nunca é salvo.
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?

  @@index([userId])
}

model Document {
  id             String           @id @default(cuid())
  type           DocumentType     @default(MINDMAP)
  title          String
  ownerId        String
  owner          User             @relation("owner", fields: [ownerId], references: [id])
  /// Estado binário do Y.Doc.
  yState         Bytes?
  /// Texto dos nós (até 10k chars), para busca.
  searchText     String           @default("")
  sizeBytes      Int              @default(0)
  trashedAt      DateTime?
  lastEditedById String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  members        DocumentMember[]
  snapshots      Snapshot[]
  /// Pasta compartilhada em que o documento está (SPEC-004 §2.1). Global, no máximo uma.
  sharedFolderId String?
  sharedFolder   Folder?          @relation("sharedFolder", fields: [sharedFolderId], references: [id], onDelete: SetNull)
  placements     DocumentPlacement[]

  @@index([ownerId, trashedAt])
  @@index([trashedAt])
  @@index([sharedFolderId])
}

/// Pasta do painel (SPEC-004 §2.1). Até 3 níveis.
model Folder {
  id        String     @id @default(cuid())
  kind      FolderKind
  name      String
  /// PERSONAL: o único que a vê. SHARED: dono da pasta.
  ownerId   String
  owner     User       @relation("folderOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Folder?    @relation("folderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]   @relation("folderTree")
  /// Pasta principal (1º nível) — onde ficam os membros. Igual ao id quando depth = 0.
  rootId    String
  root      Folder     @relation("folderRoot", fields: [rootId], references: [id], onDelete: Cascade)
  branch    Folder[]   @relation("folderRoot")
  /// 0, 1 ou 2.
  depth     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  members    FolderMember[]
  placements DocumentPlacement[]
  sharedDocs Document[]          @relation("sharedFolder")

  @@index([ownerId, kind, parentId])
  @@index([rootId])
}

/// Membro de uma pasta compartilhada. Só EDITOR ou VIEWER — o dono é Folder.ownerId.
model FolderMember {
  folderId  String
  userId    String
  role      MemberRole
  addedById String?
  createdAt DateTime   @default(now())
  folder    Folder     @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([folderId, userId])
  @@index([userId])
}

/// Documento numa pasta PESSOAL: vínculo por usuário, invisível para os outros.
model DocumentPlacement {
  documentId String
  userId     String
  folderId   String
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder     Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@id([documentId, userId])
  @@index([folderId])
  @@index([userId])
}

/// Versão congelada do documento (SPEC-005 §2.1). Apagar o documento de vez
/// apaga o histórico; mandar para a lixeira não.
model Snapshot {
  id          String       @id @default(cuid())
  documentId  String
  document    Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  kind        SnapshotKind
  /// Só em NAMED e CHECKPOINT ("Antes de restaurar…").
  name        String?
  /// Estado do Y.Doc, igual ao Document.yState.
  state       Bytes
  sizeBytes   Int
  /// Quem editou no intervalo coberto por esta versão. Só ids.
  editorIds   String[]     @default([])
  createdById String?
  createdAt   DateTime     @default(now())

  @@index([documentId, createdAt])
  @@index([kind, createdAt])
}

model DocumentMember {
  documentId String
  userId     String
  role       MemberRole
  addedById  String?
  createdAt  DateTime   @default(now())
  document   Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([documentId, userId])
  @@index([userId])
}

model AuditEvent {
  id        String   @id @default(cuid())
  actorId   String?
  /// ex.: auth.login, auth.login_failed, user.created, document.shared
  action    String
  targetId  String?
  /// Nunca senha, token ou conteúdo de documento.
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
