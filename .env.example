# Copie para `.env` e preencha. NUNCA commite o `.env`.

# ------------------------------------------------------------------
# Desenvolvimento local (lido por `pnpm dev` e `pnpm db:deploy`)
# ------------------------------------------------------------------
# Sem Docker: `pnpm db:local` sobe um Postgres em WebAssembly (PGlite) na
# porta 5432, com os dados em apps/api/.pglite. `pgbouncer=true` é
# obrigatório com o PGlite.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable&connection_limit=5&pgbouncer=true
# Com Docker (docker-compose.dev.yml), use esta no lugar:
# DATABASE_URL=postgresql://diagram:diagram@localhost:5432/diagram?schema=public
APP_URL=http://localhost:5173
# Gere com: openssl rand -base64 48
SESSION_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
LOG_LEVEL=debug
SEED_ADMIN_EMAIL=admin@paglamp.com.br
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_PASSWORD=admin-local-123

# ------------------------------------------------------------------
# Produção (lido pelo docker-compose.yml na VPS)
# ------------------------------------------------------------------
DIAGRAM_DOMAIN=diagram.paglamp.com.br
POSTGRES_USER=diagram
POSTGRES_PASSWORD=
POSTGRES_DB=diagram
TRAEFIK_NETWORK=traefik
TRAEFIK_CERT_RESOLVER=leresolver
# Primeiro admin: preencha só para a 1ª subida e APAGUE a senha depois.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_NAME=
# SEED_ADMIN_PASSWORD=
# Opcional: restringir e-mails de novos acessos a certos domínios (vazio = qualquer).
# ALLOWED_EMAIL_DOMAINS=
